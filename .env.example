# ========================================================
# Renaissance - Environment Configuration (.env.example)
# ========================================================

# Server Port (Render sets PORT dynamically; fallback is 8080)
PORT=8080

# Railway MySQL Database Configuration (Render Environment Variables)
# Construct using Railway's Public TCP Proxy host and port:
# Example:
# SPRING_DATASOURCE_URL=jdbc:mysql://junction.proxy.rlwy.net:43195/railway?sslMode=REQUIRED&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_URL=jdbc:mysql://<PUBLIC_HOST>:<PUBLIC_PORT>/<DATABASE_NAME>?sslMode=REQUIRED&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_railway_mysql_password_here

# Active Spring Profile (Optional: set to 'production' on Render)
SPRING_PROFILES_ACTIVE=production

# Initial Faculty Admin Provisioning (Auto-seeded on first run)
RENAISSANCE_ADMIN_EMAIL=teacher@renaissance.edu
RENAISSANCE_ADMIN_PASSWORD=Admin@1234
RENAISSANCE_ADMIN_NAME=Prof. Charles Babbage
RENAISSANCE_ADMIN_EMP_ID=EMP001

# GPS Geofence Constraints
RENAISSANCE_GEOFENCE_RADIUS_METERS=15.0
RENAISSANCE_GEOFENCE_MAX_ALLOWED_GPS_ACCURACY=100.0
