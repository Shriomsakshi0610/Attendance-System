# ========================================================
# Renaissance - Environment Configuration (.env.example)
# ========================================================

# Server Port (Render sets PORT dynamically; default fallback is 8080)
PORT=8080

# --------------------------------------------------------
# MongoDB Atlas Database Configuration (Render Web Service)
# --------------------------------------------------------
# Obtain your MongoDB Atlas connection string:
# 1. Open your MongoDB Atlas project on https://cloud.mongodb.com
# 2. Go to "Database" -> Click "Connect" on your cluster
# 3. Choose "Drivers" (Java) or "Compass" / Standard connection string
# 4. Replace <username> and <password> with your actual database user credentials
#
# Format:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
#
# Example:
# MONGODB_URI=mongodb+srv://renaissance_admin:SecurePass123@cluster0.abcde.mongodb.net/renaissance_db?retryWrites=true&w=majority

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/renaissance_db?retryWrites=true&w=majority

# Active Spring Profile for Render
SPRING_PROFILES_ACTIVE=production

# Initial Faculty Admin Provisioning (Auto-seeded on first run)
RENAISSANCE_ADMIN_EMAIL=teacher@renaissance.edu
RENAISSANCE_ADMIN_PASSWORD=Admin@1234
RENAISSANCE_ADMIN_NAME=Prof. Charles Babbage
RENAISSANCE_ADMIN_EMP_ID=EMP001

# GPS Geofence Constraints
RENAISSANCE_GEOFENCE_RADIUS_METERS=15.0
RENAISSANCE_GEOFENCE_MAX_ALLOWED_GPS_ACCURACY=100.0
