# ========================================================
# Renaissance - Environment Configuration (.env.example)
# ========================================================

# Server Port (Render sets PORT dynamically; default fallback is 8080)
PORT=8080

# --------------------------------------------------------
# Railway MySQL Database Configuration (Render Web Service)
# --------------------------------------------------------
# IMPORTANT FOR RENDER DEPLOYMENT:
# - Do NOT use Railway's internal hostname (mysql.railway.internal).
# - Do NOT paste raw Railway template syntax like ${{RAILWAY_TCP_PROXY_DOMAIN}}.
# - Render CANNOT resolve Railway internal variables. You must paste the REAL resolved values.
#
# Get your Public Host and Port from Railway Dashboard:
# 1. Open your project on https://railway.com
# 2. Click your MySQL service -> "Networking" (or "Settings" -> "Public Networking")
# 3. Look under "Public Networking" / "TCP Proxy" for the public host and port:
#    - Public Host: e.g. junction.proxy.rlwy.net
#    - Public Port: e.g. 43195
#
# Assemble the JDBC URL in Render Environment as:
# SPRING_DATASOURCE_URL=jdbc:mysql://PUBLIC_HOST:PUBLIC_PORT/railway?sslMode=REQUIRED&allowPublicKeyRetrieval=true&serverTimezone=UTC
# Example:
# SPRING_DATASOURCE_URL=jdbc:mysql://junction.proxy.rlwy.net:43195/railway?sslMode=REQUIRED&allowPublicKeyRetrieval=true&serverTimezone=UTC

SPRING_DATASOURCE_URL=jdbc:mysql://ACTUAL_PUBLIC_HOST:ACTUAL_PUBLIC_PORT/railway?sslMode=REQUIRED&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_actual_railway_password_here

# Active Spring Profile for Render
SPRING_PROFILES_ACTIVE=production

# Initial Faculty Admin Provisioning (Auto-seeded on first run)
RENAISSANCE_ADMIN_EMAIL=teacher@renaissance.edu
RENAISSANCE_ADMIN_PASSWORD=Admin@1234
RENAISSANCE_ADMIN_NAME=Prof. Charles Babbage
RENAISSANCE_ADMIN_EMP_ID=EMP001

# GPS Geofence Constraints
RENAISSANCE_GEOFENCE_RADIUS_METERS=15.0
RENAISSANCE_GEOFENCE_MAX_ALLOWED_GPS_ACCURACY=100.0
